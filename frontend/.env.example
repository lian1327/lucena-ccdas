# Copy to .env.local. In dev, leave VITE_API_URL as /api/v1 so the Vite proxy handles CORS.
VITE_API_URL=/api/v1
VITE_LGU_NAME=City Government of Lucena

# ---- Public site identity (optional) ----
VITE_LGU_SHORT=Lungsod ng Lucena
VITE_LGU_PROVINCE=Lalawigan ng Quezon
# VITE_LGU_ADDRESS=
# VITE_LGU_EMAIL=
# VITE_LGU_PHONE=
# VITE_LGU_WEBSITE=
# VITE_LGU_FACEBOOK=
# Extra hotlines as JSON. Confirm every number with the office first.
# VITE_LGU_HOTLINES=[{"label":"CDRRMO","number":"(042) 000-0000","note":"Baha, bagyo"}]
# Name the boundary data source (required credit):
# VITE_MAP_CREDIT=Map data © OpenStreetMap contributors · Barangay/purok boundaries: <source>
