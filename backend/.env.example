# Local development. Copy to backend/.env (never commit .env).
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=ccadss
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgresql://...   (if set, used instead of DB_*)
SITE_MODE=prototype                # prototype | official (official only with the City's written authorization)
ORG_NAME=Dalubhasaan ng Lungsod ng Lucena
CONTACT_EMAIL=
PUBLIC_SAMPLE_DATA=True
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
SMS_PROVIDER=console
SEMAPHORE_API_KEY=
SMS_SENDER_NAME=
SMS_SIGNATURE=CCADSS DLL
NOTIFY_EMAIL=1
CRON_TOKEN=
# MEDIA_S3_BUCKET= / MEDIA_S3_ENDPOINT= / MEDIA_S3_REGION= / MEDIA_S3_ACCESS_KEY_ID= / MEDIA_S3_SECRET_ACCESS_KEY=
# (leave empty locally: files go to backend/media/)
